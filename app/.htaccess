# Rutas SPA, incluidas /es/proyectos y detalles. No reescribir recursos ni servicios.
Options -MultiViews
RewriteEngine On
RewriteRule ^(?:api|brand|auth|storage|\.well-known)(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule \.[^/]+$ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>
