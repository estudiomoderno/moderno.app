# Moderno.app — rutas con nombre (/proyectos, /administracion, /proyecto/7)
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]

# El index nunca se sirve de caché: cada subida llega al instante
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>
