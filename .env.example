# Copia este archivo a .env y usa EXCLUSIVAMENTE el proyecto de pruebas.
# .env nunca se sube a GitHub. npm run dev lo carga con Node >=22.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo una clave anon o sb_publishable_. No poner claves administrativas aquí.

# Secretario: activación local opcional, únicamente con Moderno Prueba.
# Requiere primero permisos, funciones de datos y Edge Function verificados.
MODERNO_SECRETARY_ENABLED=false
# Activar solo tras instalar y verificar SQL/secretario-feedback.sql en pruebas.
MODERNO_SECRETARY_FEEDBACK_ENABLED=false
# OPENAI_API_KEY se configura exclusivamente como secreto de servidor,
# nunca en el navegador ni en este archivo de ejemplo.
